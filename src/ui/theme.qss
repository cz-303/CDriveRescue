/* CDriveRescue 主题 (Claude)
   暖白纸面 + 墨青强调色；绿/琥珀/珊瑚只用于表达状态。 */

* {
    font-family: "Microsoft YaHei UI", "Microsoft YaHei", "Segoe UI", "PingFang SC", "Noto Sans CJK SC", sans-serif;
    font-size: 13px;
    color: #1F2A2E;
}

QMainWindow, #pageRoot, QStackedWidget, QScrollArea, QScrollArea > QWidget > QWidget {
    background: #F6F3EE;
}

/* ---------- 侧边栏 ---------- */
#sidebar {
    background: #1F2A2E;
    min-width: 196px;
    max-width: 196px;
}
#sidebar QLabel { color: #E9E4DA; }
#brandTitle { font-size: 17px; font-weight: 600; color: #FFFFFF; }
#brandSub { font-size: 12px; color: #9AA5A8; }
#navList {
    background: transparent;
    border: none;
    outline: none;
}
#navList::item {
    color: #C9D1D3;
    padding: 10px 14px;
    margin: 2px 10px;
    border-radius: 8px;
}
#navList::item:hover { background: #2B383D; color: #FFFFFF; }
#navList::item:selected { background: #1F6F78; color: #FFFFFF; }
#navList::item:disabled { color: #5D6A6E; }
#sidebarFoot { font-size: 12px; color: #9AA5A8; }
#busyLabel { font-size: 12px; color: #F2C14E; }

/* ---------- 页面 ---------- */
#pageTitle { font-size: 22px; font-weight: 600; }
#pageSub { color: #6B7378; }
#muted, QLabel#muted { color: #6B7378; }
#headline { font-size: 15px; line-height: 150%; }
#sectionTitle { font-size: 14px; font-weight: 600; }

#card {
    background: #FFFFFF;
    border: 1px solid #E6E1D8;
    border-radius: 12px;
}
#cardTitle { font-size: 14px; font-weight: 600; }

#statTile {
    background: #FBFAF7;
    border: 1px solid #ECE7DE;
    border-radius: 10px;
}
#statValue { font-size: 20px; font-weight: 600; }
#statCaption { color: #6B7378; font-size: 12px; }

/* ---------- 提示条 ---------- */
#banner_info   { background: #E7F1F2; border: 1px solid #BFD9DC; border-radius: 10px; }
#banner_warn   { background: #FBF1DC; border: 1px solid #EBCF8F; border-radius: 10px; }
#banner_danger { background: #F8E3E0; border: 1px solid #E3A49C; border-radius: 10px; }

/* ---------- 徽章 ---------- */
#badgeSafe, #badgeCaution, #badgeDanger {
    border-radius: 9px;
    padding: 1px 8px;
    font-size: 12px;
    font-weight: 600;
}
#badgeSafe    { background: #E2F2E8; color: #2F8F5B; }
#badgeCaution { background: #FBEFD5; color: #A87008; }
#badgeDanger  { background: #F8E1DE; color: #C9473D; }

/* ---------- 按钮 ---------- */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #D5CFC4;
    border-radius: 8px;
    padding: 7px 16px;
}
QPushButton:hover { background: #F1EDE6; }
QPushButton:pressed { background: #E7E1D7; }
QPushButton:disabled { color: #A8ADB0; background: #F3F1ED; border-color: #E4E0D8; }

QPushButton#primaryButton {
    background: #1F6F78;
    border: 1px solid #1F6F78;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#primaryButton:hover { background: #185C64; }
QPushButton#primaryButton:disabled { background: #9DBFC2; border-color: #9DBFC2; color: #F2F6F6; }

QPushButton#dangerButton {
    background: #C9473D;
    border: 1px solid #C9473D;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#dangerButton:hover { background: #AF3B32; }
QPushButton#dangerButton:disabled { background: #E3B1AC; border-color: #E3B1AC; color: #FFF6F5; }

QPushButton#linkButton {
    background: transparent;
    border: none;
    color: #1F6F78;
    padding: 2px 4px;
    text-decoration: underline;
}

/* ---------- 列表与表格 ---------- */
QTreeWidget, QTableWidget, QPlainTextEdit, QListWidget#plainList {
    background: #FFFFFF;
    border: 1px solid #E6E1D8;
    border-radius: 10px;
    gridline-color: #F0ECE5;
    selection-background-color: #D7E8EA;
    selection-color: #1F2A2E;
    alternate-background-color: #FBFAF7;
}
QHeaderView::section {
    background: #F6F3EE;
    border: none;
    border-bottom: 1px solid #E6E1D8;
    padding: 6px 8px;
    font-weight: 600;
    color: #4A5458;
}
QTreeWidget::item, QTableWidget::item { padding: 4px 2px; }

/* ---------- 输入 ---------- */
QComboBox, QLineEdit, QSpinBox {
    background: #FFFFFF;
    border: 1px solid #D5CFC4;
    border-radius: 8px;
    padding: 5px 8px;
    min-height: 20px;
}
QComboBox::drop-down {
    border: none;
    width: 26px;
}
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #D5CFC4;
    selection-background-color: #D7E8EA;
}
QComboBox:focus, QLineEdit:focus, QSpinBox:focus { border-color: #1F6F78; }
QCheckBox { spacing: 6px; }

/* ---------- 进度条 ---------- */
QProgressBar {
    background: #E6E1D8;
    border: none;
    border-radius: 4px;
}
QProgressBar::chunk {
    background: #1F6F78;
    border-radius: 4px;
}

QScrollArea { border: none; }
QToolTip {
    background: #1F2A2E;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}
